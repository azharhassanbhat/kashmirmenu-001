<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging.

  dev keeps the human-readable console pattern; prod emits one JSON object per line so logs are
  queryable by field rather than by substring, and so requestId is a first-class property ready for
  a collector later (see the deferred Loki step in OBSERVABILITY_PLAN.md).

  On redaction: nothing here filters secrets, because the application does not log them in the first
  place - credentials are never passed to a logger, auth logs record user ids rather than email
  addresses, and the Google Places client excludes its API key from failure messages. A filter here
  would be a second line of defence against a mistake upstream; the first line is not making it.
  The one deliberate exception is the platform-owner claim token, which is logged exactly once by
  design because the operator has no other way to receive it.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <version/>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <message/>
                    <!-- requestId, already populated by RequestIdFilter, becomes a queryable field
                         rather than part of the message string. -->
                    <mdc/>
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                    <pattern>
                        <pattern>{"application":"kashmirmenu"}</pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="com.kashmirmenu" level="INFO"/>
    </springProfile>

</configuration>
