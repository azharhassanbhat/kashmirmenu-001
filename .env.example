# Copy to .env and fill in real values. Never commit the real .env file.

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_NAME=kashmir_menu
DB_USERNAME=kashmirmenu
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Only needed if not using docker-compose's mysql service:
# DB_URL=jdbc:mysql://localhost:3306/kashmir_menu

# --- Auth ---
# Generate with: openssl rand -base64 48
# Generate a real value - the app refuses to start on a placeholder:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=86400000

# --- CORS ---
# Comma-separated list of origins allowed to call the API/websocket.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Public URL (REQUIRED in prod) ---
# Public address of the frontend. Table QR codes encode {PUBLIC_BASE_URL}/menu/<table-id>.
PUBLIC_BASE_URL=https://your-frontend.example.com
FRONTEND_PORT=3000

# --- Business time zone and currency ---
# All day/hour boundaries in the Payments & Revenue reports use this zone. It is applied to
# both the app and the MySQL container, so change it before collecting data, not after.
APP_TIMEZONE=Asia/Kolkata
# Currency payments are stored and displayed in. Keep equal to the frontend's VITE_CURRENCY.
APP_CURRENCY=INR

# --- Platform administration ---
# Set this once to provision the platform owner (the person who runs the whole platform, not a
# restaurant owner). On first start the app creates a DISABLED account for this address and logs a
# single-use claim token; call POST /api/platform-admin/claim with that token to set a password.
# No password is ever stored in this file. It must NOT be an address that already has an account.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=Platform Owner
# true (default): a newly registered restaurant is PENDING and cannot operate until the platform owner
# approves it in /platform-admin. false: registrations start APPROVED, as before approval existed.
RESTAURANT_APPROVAL_REQUIRED=true

# --- Observability (docker-compose.observability.yml) ---
# No default: compose refuses to start rather than falling back to admin/admin.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Grafana is published to 127.0.0.1 only. Prometheus publishes no host port at all.
GRAFANA_PORT=3001
PROMETHEUS_RETENTION=15d
# Actuator's port. Never published to the host; Prometheus reaches it over the internal network.
MANAGEMENT_PORT=9091
# Labels every metric, so one Prometheus can tell deployments apart.
ENVIRONMENT=local

# --- Rate limiting ---
AUTH_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Ordering writes (/api/public/**) per window. Per IP, a generous ceiling against abuse (every phone in a
# restaurant shares one wifi address); per guest (their own token), the limit a diner actually meets.
PUBLIC_RATE_LIMIT=600
PUBLIC_GUEST_RATE_LIMIT=60
# Order-tracking reads per IP (guests poll their order screen, so higher than writes).
PUBLIC_TRACK_RATE_LIMIT=1200

# Most guests one table visit admits (guests join with just a name, so this is capped).
TABLE_SESSION_MAX_DINERS=30

# A table nobody has touched for this long is idle: closed automatically if paid up, flagged for staff if not.
TABLE_SESSION_IDLE_TIMEOUT=PT3H

# true: a guest can pay an order only once the kitchen has confirmed it. false: as soon as it is placed.
BILLING_REQUIRE_CONFIRMED_ORDERS=true
# Only set true if behind a reverse proxy that sets/strips X-Forwarded-For.
# docker-compose defaults this to true because the bundled nginx does so.
TRUST_FORWARDED_HEADER=false
# Optional: Google Places API (New) key, server-side only. Enables the Google rating
# and recent reviews on the menu. Without it diners still get "Review us on Google".
# Restrict the key to the Places API in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# QR landing page: limits on writes that need no sign-in, per client IP per table QR (optional).
# LANDING_FEEDBACK_RATE_LIMIT=5
# LANDING_REWARDS_RATE_LIMIT=20
# LANDING_RATE_LIMIT_WINDOW_SECONDS=600
