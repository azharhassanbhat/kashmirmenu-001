# Leave empty to call the API on the same origin (Vite proxy in dev, nginx proxy in Docker).
# Set only if the API lives on another origin; that origin must then list this app in CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Display currency for the staff console. Keep equal to the backend's APP_CURRENCY,
# which is the currency payments are actually stored and reported in.
VITE_CURRENCY=INR
