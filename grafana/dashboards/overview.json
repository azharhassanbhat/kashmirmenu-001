    },
    {
      "type": "timeseries",
      "title": "Throughput by status",
      "description": "Traffic split by HTTP status, so a rise in 4xx is distinguishable from a rise in load.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
