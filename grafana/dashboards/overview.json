              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Failed sign-ins / sec",
      "description": "Counts only. No identifiers are recorded in metrics; see the audit log.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
