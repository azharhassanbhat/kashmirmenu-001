    {
      "type": "timeseries",
      "title": "Rate-limited requests (429) / sec",
      "description": "The application throttles sign-in, the platform claim and public writes. Sustained 429s mean the limiter is doing something.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"kashmirmenu\",status=\"429\"}[$__rate_interval]))",
          "legendFormat": "429s",
          "refId": "A",
