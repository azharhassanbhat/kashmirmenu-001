{
  "uid": "km-security",
  "title": "KashmirMenu \u2014 Security Signals",
  "description": "Authentication and authorization signals. These are observations, not verdicts: a spike here is an anomaly to investigate, not a confirmed attack.",
  "tags": [
    "kashmirmenu",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Every panel shows a **signal**, not an incident. A rise in failed sign-ins is as often a released client with a broken token refresh, or a staff member who forgot a password, as it is an attack.\n\nMetrics here carry **no identifiers** - no email, IP, user id or token - by design. To investigate an individual event, use the audit log in the platform admin area, which records the actor and resource for each action."
      }
    },
    {
      "type": "timeseries",
      "title": "Failed sign-ins / sec",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (reason) (rate(app_authentication_failures_total{job=\"kashmirmenu\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed sign-ins vs 24h baseline",
      "description": "The ElevatedAuthenticationFailures alert compares these two. Seeing both makes it obvious whether a spike is unusual for this deployment.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(rate(app_authentication_failures_total{job=\"kashmirmenu\"}[$__rate_interval]))",
          "legendFormat": "current",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(rate(app_authentication_failures_total{job=\"kashmirmenu\"}[24h]))",
          "legendFormat": "24h baseline",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Authorization refusals (403) / sec",
      "description": "Already available from the standard request metric, so no custom counter was added. A steady trickle is normal - the API denies by default. A spike on one endpoint is worth a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\",status=\"403\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Unauthenticated rejections (401) / sec",
      "description": "Expired tokens produce these routinely; a step change usually means a deployment or a secret rotation.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"kashmirmenu\",status=\"401\"}[$__rate_interval]))",
          "legendFormat": "401s",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
