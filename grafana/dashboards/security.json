          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Server error spikes by endpoint",
      "description": "An abnormal error spike can be the symptom of probing as easily as of a bug. Correlate with the panels above before concluding either.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "topk(5, sum by (uri) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\",status=~\"5..\"}[$__rate_interval])))",
