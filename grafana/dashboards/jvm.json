{
  "uid": "km-jvm",
  "title": "KashmirMenu \u2014 JVM Performance",
  "description": "Memory, garbage collection, CPU and threads for the backend JVM.",
  "tags": [
    "kashmirmenu",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Heap used / max",
      "description": "A sawtooth is healthy: it is the collector doing its job. Sustained high used against max is the thing to worry about.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"kashmirmenu\",area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{job=\"kashmirmenu\",area=\"heap\"})",
          "legendFormat": "max",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Heap utilisation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"kashmirmenu\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"kashmirmenu\",area=\"heap\"}), 1)",
          "legendFormat": "utilisation",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Non-heap used",
      "description": "Metaspace and code cache. Steady growth here suggests a class or classloader leak rather than an object leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{job=\"kashmirmenu\",area=\"nonheap\"})",
          "legendFormat": "{{id}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
