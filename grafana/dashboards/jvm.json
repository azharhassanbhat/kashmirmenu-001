            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{job=\"kashmirmenu\",area=\"heap\"})",
          "legendFormat": "{{id}}",
          "refId": "A",
          "editorMode": "code",
