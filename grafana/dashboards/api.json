{
  "uid": "km-api",
  "title": "KashmirMenu \u2014 API Performance",
  "description": "Per-endpoint latency and throughput. The uri label is Spring's route template, never a raw path, so order ids and tokens never appear here.",
  "tags": [
    "kashmirmenu",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Slowest endpoints (P95)",
      "description": "Grouping by le and uri together is required: dropping le would make histogram_quantile meaningless.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"kashmirmenu\"}[$__rate_interval]))))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\",status=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Status distribution",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Mean latency by endpoint",
      "description": "Mean, not P95: useful for spotting an endpoint that is uniformly slow rather than occasionally slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_sum{job=\"kashmirmenu\"}[$__rate_interval])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"kashmirmenu\"}[$__rate_interval])), 0.001))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Request count by endpoint and method",
      "description": "Totals over the selected range. Useful for deciding which endpoints a load test should actually cover.",
      "datasource": {
        "type": "prometheus",
        "uid": "kashmirmenu-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kashmirmenu-prometheus"
          },
          "expr": "sum by (uri, method) (increase(http_server_requests_seconds_count{job=\"kashmirmenu\"}[$__range]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "templating": {
    "list": []
  }
}
