import { blockedByStock, defaultSelection, deltaText, optionsSummary, previewPrice, selectionProblem, toggleOption } from '../../../frontend/src/lib/menuOptions.ts';
import assert from 'node:assert/strict';
const opt=(id:number,name:string,d:number,x:any={})=>({id,name,priceDelta:d,available:true,defaultOption:false,...x});
const portion:any={id:1,name:'Portion',kind:'SINGLE',required:true,maxSelect:null,options:[opt(10,'Half',-80),opt(11,'Full',0,{defaultOption:true}),opt(12,'Family',250)]};
const extras:any={id:2,name:'Extras',kind:'MULTI',required:false,maxSelect:2,options:[opt(20,'Raita',30),opt(21,'Egg',20),opt(22,'Salan',25),opt(23,'Papad',10,{available:false})]};
const spice:any={id:3,name:'Spice',kind:'SINGLE',required:false,maxSelect:null,options:[opt(30,'Mild',0),opt(31,'Hot',0)]};
const g=[portion,extras,spice];
assert.deepEqual([...defaultSelection(g)],[11]);
assert.equal(defaultSelection([{...portion,options:[opt(1,'Full',0,{defaultOption:true,available:false})]}]).size,0);
assert.equal(previewPrice(320,g,new Set([12,20,21])),620); assert.equal(previewPrice(320,g,new Set([10])),240); assert.equal(previewPrice(320,g,new Set()),320);
assert.equal(selectionProblem(g,new Set([20])),'Please choose Portion.'); assert.equal(selectionProblem(g,new Set([11])),null);
assert.equal(selectionProblem(g,new Set([11,20,21,22])),'You can choose up to 2 for Extras.'); assert.equal(selectionProblem(g,new Set([10,11])),'Please choose only one for Portion.');
assert.deepEqual([...toggleOption(portion,12,new Set([11]))],[12]);
assert.deepEqual([...toggleOption(portion,11,new Set([11]))],[11]); assert.equal(toggleOption(spice,30,new Set([30])).size,0);
let s=new Set<number>(); s=toggleOption(extras,20,s); s=toggleOption(extras,21,s); s=toggleOption(extras,22,s); assert.deepEqual([...s].sort(),[20,21]); s=toggleOption(extras,20,s); assert.deepEqual([...s],[21]);
assert.equal(toggleOption(extras,23,new Set()).size,0);
const f=(n:number)=>`Rs ${n}`; assert.equal(deltaText(30,f),'+Rs 30'); assert.equal(deltaText(-80,f),'\u2212Rs 80'); assert.equal(deltaText(0,f),'');
assert.equal(optionsSummary([{groupName:'P',optionName:'Full',priceDelta:0},{groupName:'E',optionName:'Raita',priceDelta:30}]),'Full \u00b7 Raita'); assert.equal(optionsSummary(undefined),'');
assert.equal(blockedByStock([{...portion,options:portion.options.map((o:any)=>({...o,available:false}))}]),'Portion'); assert.equal(blockedByStock(g),null);
console.log('MENU OPTION HELPERS PASSED');
import { startingPrice } from '../../../frontend/src/lib/menuOptions.ts';
assert.equal(startingPrice(320,g),240); assert.equal(startingPrice(100,[extras,spice]),100);
assert.equal(startingPrice(100,[{...portion,options:portion.options.map((o:any)=>({...o,available:o.id!==10}))}]),100);
console.log('STARTING PRICE PASSED');
import { lineLabel } from '../../../frontend/src/lib/menuOptions.ts';
assert.equal(lineLabel(2,'Biryani',[{groupName:'P',optionName:'Family',priceDelta:250},{groupName:'E',optionName:'Raita',priceDelta:30}]),'2 \u00d7 Biryani (Family \u00b7 Raita)');
assert.equal(lineLabel(1,'Naan',undefined),'1 \u00d7 Naan');
console.log('LINE LABEL PASSED');
